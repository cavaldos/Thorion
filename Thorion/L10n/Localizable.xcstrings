    "Allow “charging-helper” in System Settings → Login Items & Extensions to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube „charging-helper“ unter Systemeinstellungen → Anmeldeobjekte & Erweiterungen, um fortzufahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite “charging-helper” en Ajustes del Sistema → Ítems de inicio y extensiones para continuar."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite “charging-helper” en Ajustes del Sistema → Ítems de inicio y extensiones para continuar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続行するには、システム設定 → ログイン項目と機能拡張 で「charging-helper」を許可してください。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép “charging-helper” trong Cài đặt hệ thống → Mục đăng nhập & Tiện ích mở rộng để tiếp tục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置”→“登录项与扩展”中允许“charging-helper”以继续。"
