    "When “Update in background” is off, the power distribution diagram only refreshes while the menu or the dashboard is open, which saves energy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn „Im Hintergrund aktualisieren“ deaktiviert ist, wird das Leistungsverteilungsdiagramm nur aktualisiert, solange das Menü oder das Dashboard geöffnet ist. Das spart Energie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si «Actualizar en segundo plano» está desactivado, el diagrama de distribución de energía solo se actualiza mientras el menú o el panel están abiertos, lo que ahorra energía."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si «Actualizar en segundo plano» está desactivado, el diagrama de distribución de energía solo se actualiza mientras el menú o el panel están abiertos, lo que ahorra energía."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「バックグラウンドで更新」がオフの場合、電力分配図はメニューまたはダッシュボードを開いている間だけ更新され、電力を節約します。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi tắt “Cập nhật nền”, sơ đồ phân phối nguồn chỉ cập nhật khi menu hoặc bảng điều khiển đang mở, giúp tiết kiệm năng lượng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭“在后台更新”后，电力分配图仅在菜单或仪表盘打开时刷新，以节省电量。"
          }
        }
      }
    }
  },
  "version" : "1.1"
